type (
	LoginReq {
		Username string `json:"username"`
		Password string `json:"password"`
	}

	LoginReply {
		Id           int64  `json:"id"`
		Name         string `json:"name"`
		Gender       string `json:"gender"`
		AccessToken  string `json:"accessToken"`
		AccessExpire int64  `json:"accessExpire"`
		RefreshAfter int64  `json:"refreshAfter"`
	}
	UserReq {
		UserId int64 `json:"userid"`
	}
	UserReply {
		Id     int64  `json:"id"`
		Name   string `json:"name"`
		Gender string `json:"gender"`
	}
	UserUpdateReq {
		Id       int64  `json:"id"`
		Name     string `json:"name"`
		Password string `json:"password"`
		Gender   string `json:"gender"`
	}
	UserUpdateReply {
		ResCode string `json:"rescode"`
		ResDesc string `json:"resdesc"`
	}
	UserSaveReq {
		Name     string `json:"name"`
		Password string `json:"password"`
		Gender   string `json:"gender"`
	}
	UserSaveReply {
		ResCode string `json:"rescode"`
		ResDesc string `json:"resdesc"`
	}
	UserDeleteReq {
		Id int64 `json:"id"`
	}
	UserDeleteReply {
		ResCode string `json:"rescode"`
		ResDesc string `json:"resdesc"`
	}
)

service user-api {
	@handler login
	post /user/login (LoginReq) returns (LoginReply)
	@handler saveuser
	post /user/saveuser (UserSaveReq) returns (UserSaveReply)
}

@server(
	jwt: Auth
)
service user-api {
	@handler getusers
	get /user/getusers () returns (UserReply)
	@handler getuser
	post /user/getuser (UserReq) returns (UserReply)
	@handler updateUser
	post /user/updateuser (UserUpdateReq) returns (UserUpdateReply)
	@handler deleteUser
	delete /user/deleteuser (UserDeleteReq) returns (UserDeleteReply)
}

service user-api {
	@handler ping
	get /user/ping
}